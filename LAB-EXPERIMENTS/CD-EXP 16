#include <stdio.h>
#include <string.h>

int main()
{
    int n;
    char result[20], arg1[20], op[5], arg2[20];

    printf("Enter number of three address code statements: ");
    scanf("%d", &n);

    printf("\nEnter statements in the form:\n");
    printf("t1 = a + b\n");
    printf("t2 = t1 * c\n");
    printf("a = t2\n\n");

    printf("----- TARGET CODE -----\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%s = %s %s %s", result, arg1, op, arg2);

        if (strcmp(op, "+") == 0)
        {
            printf("MOV R0, %s\n", arg1);
            printf("ADD R0, %s\n", arg2);
            printf("MOV %s, R0\n\n", result);
        }
        else if (strcmp(op, "-") == 0)
        {
            printf("MOV R0, %s\n", arg1);
            printf("SUB R0, %s\n", arg2);
            printf("MOV %s, R0\n\n", result);
        }
        else if (strcmp(op, "*") == 0)
        {
            printf("MOV R0, %s\n", arg1);
            printf("MUL R0, %s\n", arg2);
            printf("MOV %s, R0\n\n", result);
        }
        else if (strcmp(op, "/") == 0)
        {
            printf("MOV R0, %s\n", arg1);
            printf("DIV R0, %s\n", arg2);
            printf("MOV %s, R0\n\n", result);
        }
        else
        {
            // Simple assignment such as a = t1
            printf("MOV R0, %s\n", arg1);
            printf("MOV %s, R0\n\n", result);
        }
    }

    return 0;
}X
